// Notiono — esquema de datos (Fase 0)
// Enfoque híbrido: páginas = documento JSON de bloques; bases de datos del usuario = filas reales.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String?
  role         String       @default("member") // member | admin (nivel sistema)
  createdAt    DateTime     @default(now())
  memberships  Member[]
  sessions     Session[]
  ownedSpaces  Workspace[]  @relation("owner")
  comments     Comment[]
  notifications     Notification[] @relation("recipient")
  sentNotifications Notification[] @relation("actor")
  favorites    Favorite[]
  pushSubscriptions PushSubscription[]
  pagePermissions   PagePermission[]
}

/**
 * Permiso explícito de un usuario sobre una página RESTRINGIDA. Solo cuenta en la
 * página restringida más cercana del camino hacia la raíz; owner/admin del espacio
 * tienen acceso total siempre (así nadie se cierra fuera).
 */
model PagePermission {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  level  String // view | comment | edit | full

  @@unique([pageId, userId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  icon      String?
  ownerId   String
  owner     User     @relation("owner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  members   Member[]
  pages     Page[]
  apiTokens ApiToken[]
  webhooks  Webhook[]
  notifications Notification[]
}

model Member {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("editor") // owner | editor | viewer

  @@unique([workspaceId, userId])
}

model Page {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Page?     @relation("tree", fields: [parentId], references: [id])
  children    Page[]    @relation("tree")
  title       String    @default("")
  icon        String?
  cover       String?   // "gradient:<id>" preset o "url:<imagen>"
  order       String    // índice fraccional
  type        String    @default("doc") // doc | database
  embedded    Boolean   @default(false) // contenedor oculto de una BD embebida en otra página (no sale en el árbol)
  fullWidth   Boolean   @default(false) // el contenido usa todo el ancho (toggle "Ancho completo")
  content     Json?     // documento de bloques (BlockNote) si type=doc
  ydoc        Bytes? // estado Yjs para la edición simultánea (el contenido legible sigue en content)
  publicToken String?   @unique // si no es null, la página está publicada en la web (/s/<token>)
  restricted  Boolean   @default(false) // corta la herencia: solo entra quien esté en PagePermission (y owner/admin)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  collection  Collection?
  charts      Chart[]
  versions    Version[]
  comments    Comment[]
  notifications Notification[]
  favorites   Favorite[]
  permissions PagePermission[]

  @@index([workspaceId, parentId])
}

// Página marcada como favorita por un usuario (sección ⭐ del sidebar)
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  order     String // índice fraccional: reordenar arrastrando sin renumerar
  createdAt DateTime @default(now())

  @@unique([userId, pageId])
}

// Comentarios de página (hilo lateral estilo Notion)
model Comment {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  recordId  String? // comentario de una fila de BD; NULL = comentario de la página
  record    Record?  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
  @@index([recordId])
}

// ---- Bases de datos del usuario ----
model Collection {
  id        String @id @default(cuid())
  pageId    String @unique
  page      Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  name      String
  templates Json   @default("[]") // plantillas de fila: [{ id, name, cells }]
  fields  Field[]
  records Record[]
  views   View[]
}

model Field {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  name         String
  type         String // text,number,currency,select,multiselect,date,checkbox,url,relation,rollup,formula
  order        String
  config       Json       @default("{}") // opciones de select, formato, etc.
}

model Record {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  parentId     String?    // sub-elemento: registro padre dentro de la misma colección
  parent       Record?    @relation("subitems", fields: [parentId], references: [id], onDelete: Cascade)
  children     Record[]   @relation("subitems")
  cells        Json       @default("{}") // { fieldId: value }
  createdById  String? // quién creó la fila (campo "Creado por"); sin FK, ver migración
  updatedById  String? // quién la editó por última vez (campo "Editado por")
  content      Json?      // cuerpo de bloques (BlockNote) de la fila (fila = página)
  seq          Int?       // ID incremental por colección (tipo de campo "id")
  archivedAt   DateTime? // borrado reversible: la fila desaparece de las vistas pero se puede deshacer
  order        String
  comments     Comment[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([collectionId])
  @@index([collectionId, archivedAt])
  @@index([parentId])
}

model View {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  name         String
  type         String // table | kanban | calendar | gallery | list
  config       Json       @default("{}") // filtros, orden, agrupación, columnas
  order        String // índice fraccional: el orden de las pestañas (la primera es la vista por defecto)
}

model Chart {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  name   String
  spec   Json // fuente(collection/view) + agregación + tipo + estilo
}

model Version {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  snapshot  Json
  authorId  String?
  createdAt DateTime @default(now())
}

// Bandeja de notificaciones (menciones @persona, etc.)
model Notification {
  id          String    @id @default(cuid())
  userId      String // destinatario
  user        User      @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        String    @default("mention") // mention | due | comment | assign
  key         String? // identidad del aviso para no repetirlo (due:<recordId>:<fecha>)
  title       String? // texto de la fila que vence (las notificaciones no siguen sus cambios)
  pageId      String? // dónde ocurrió
  page        Page?     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  actorId     String? // quién menciona
  actor       User?     @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([userId, key])
  @@index([userId, workspaceId, read])
}

// Ajuste global de la instalación (hoy solo el par de claves VAPID de los avisos push).
model AppSetting {
  key   String @id
  value String
}

// Navegador suscrito a los avisos push de un usuario (uno por dispositivo).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Binario subido por el usuario (portadas). Los bytes viven en Postgres: sin servicios externos.
// Sin FK a propósito: un asset puede quedar huérfano al cambiar la portada y no pasa nada.
model Asset {
  id          String   @id @default(cuid())
  workspaceId String
  mime        String
  name        String? // nombre original del fichero (adjuntos); las portadas no lo usan
  bytes       Bytes
  createdById String?
  createdAt   DateTime @default(now())
}

// Aviso saliente cuando cambian los datos: el workspace llama a una URL propia
// (el asistente del NAS, un cron…) firmando el envío con su secreto.
model Webhook {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url         String
  secret      String // firma HMAC-SHA256 de cada envío
  events      String    @default("record.created,record.updated,record.deleted")
  active      Boolean   @default(true)
  lastStatus  Int? // código HTTP del último intento, para diagnosticar
  lastAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

// Token de servicio para automatización (Dobby / crons), scopeado a un workspace
model ApiToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  scopes      String    @default("*")
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String?
  createdAt   DateTime  @default(now())
  lastUsed    DateTime?

  @@index([workspaceId])
}

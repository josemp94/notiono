<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Actualizar la app desde Ajustes: Android pide permiso para instalar el APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Tras reiniciar el móvil: repintar los widgets y reprogramar los recordatorios. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Ajustes → Widgets: pedir «batería sin restricciones» para que se actualicen solos (la app no va por Play). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Recordatorios a su hora (como un calendario): alarmas exactas. La app no va por Play;
         USE_EXACT_ALARM viene concedido desde Android 13 y en el 12 vale SCHEDULE_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />

    <queries>
        <!-- Custom Tabs para el SSO y abrir adjuntos/enlaces con otras apps. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- Xiaomi/HyperOS: la pantalla de «Inicio automático». -->
        <package android:name="com.miui.securitycenter" />
    </queries>

    <application
        android:name=".NotionoApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/extraccion_datos"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Notiono"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Notiono.Arranque"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Vuelta del SSO (notiono://auth?code=…), atajos (notiono://nueva, notiono://buscar) y widgets. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="notiono" />
            </intent-filter>
            <!-- Los enlaces a páginas de Notiono se abren en la app (y los de otro espacio, /api/espacio/…). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="notiono.monrealperez.com" android:pathPrefix="/p/" />
                <data android:scheme="https" android:host="notiono.monrealperez.com" android:pathPrefix="/api/espacio/" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- «Compartir con Notiono»: texto, enlaces, imágenes y archivos (uno o varios) de otras apps. -->
        <activity
            android:name=".compartir.CompartirActivity"
            android:exported="true"
            android:label="@string/compartir_con"
            android:theme="@style/Theme.Notiono"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Widgets (RemoteViews clásicos, widgets/Widgets.kt) y su configuración al añadirlos. -->
        <activity
            android:name=".widgets.ConfigWidgetActivity"
            android:exported="true"
            android:theme="@style/Theme.Notiono">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver android:name=".widgets.NotaReceiver" android:exported="true" android:label="@string/widget_nota">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_nota" />
        </receiver>
        <receiver android:name=".widgets.ListaReceiver" android:exported="true" android:label="@string/widget_lista">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_lista" />
        </receiver>
        <receiver android:name=".widgets.RapidaReceiver" android:exported="true" android:label="@string/widget_rapida">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_rapida" />
        </receiver>
        <receiver android:name=".widgets.AccionesReceiver" android:exported="true" android:label="@string/widget_acciones">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_acciones" />
        </receiver>
        <receiver android:name=".widgets.RecientesReceiver" android:exported="true" android:label="@string/widget_recientes">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_recientes" />
        </receiver>
        <receiver android:name=".widgets.CalendarioReceiver" android:exported="true" android:label="@string/widget_calendario">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_calendario" />
        </receiver>
        <!-- El toque en una fila de lista de un widget: abre la app o marca la casilla, sin verse. -->
        <activity
            android:name=".widgets.AccionWidgetActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Tras reiniciar, actualizar o conceder las alarmas exactas: recordatorios y widgets otra vez. -->
        <receiver android:name=".avisos.ReprogramaReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- Los recordatorios a su hora (alarmas) y el cambio de día del Calendario. -->
        <receiver android:name=".avisos.AlarmaReceiver" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.ficheros"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_ficheros" />
        </provider>
    </application>
</manifest>

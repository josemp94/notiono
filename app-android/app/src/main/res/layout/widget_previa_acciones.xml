<?xml version="1.0" encoding="utf-8"?>
<!-- Vista previa del widget en el selector (Android 12+). Los textos son los de widgets/Muestras.kt.
     Se infla como RemoteViews (sin AppCompat): por eso android:tint y no app:tint. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseAppTint,HardcodedText"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@drawable/widget_fondo" android:padding="6dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_fondo_boton">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/widget_nueva" android:tint="@color/marca" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Página"
            android:textColor="@color/widget_apagado" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp"
        android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_fondo_boton">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/widget_tarea" android:tint="@color/marca" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Tarea"
            android:textColor="@color/widget_apagado" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp"
        android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_fondo_boton">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/widget_foto" android:tint="@color/marca" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Foto"
            android:textColor="@color/widget_apagado" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp"
        android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_fondo_boton">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/widget_buscar" android:tint="@color/marca" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Buscar"
            android:textColor="@color/widget_apagado" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>

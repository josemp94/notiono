<?xml version="1.0" encoding="utf-8"?>
<!-- Vista previa del widget en el selector (Android 12+). Los textos son los de widgets/Muestras.kt.
     Se infla como RemoteViews (sin AppCompat): por eso android:tint y no app:tint. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseAppTint,HardcodedText"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_fondo" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="6dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Lista de la compra"
            android:textColor="@color/widget_texto" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp" android:src="@drawable/widget_refrescar" android:importantForAccessibility="no" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="1dp" android:paddingBottom="1dp"
        android:text="Para el sábado, antes de las 13:00" android:textColor="@color/widget_texto" android:textSize="13sp" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingStart="4dp">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_previa_casilla_hecha" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:text="Tomates" android:textColor="@color/widget_texto" android:textSize="13sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingStart="4dp">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_previa_casilla" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:text="Pan de pueblo" android:textColor="@color/widget_texto" android:textSize="13sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingStart="4dp">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_previa_casilla_hecha" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:text="Leche sin lactosa" android:textColor="@color/widget_texto" android:textSize="13sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingStart="4dp">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_previa_casilla" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:text="Café molido" android:textColor="@color/widget_texto" android:textSize="13sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingStart="4dp">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_previa_casilla" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:text="Huevos (una docena)" android:textColor="@color/widget_texto" android:textSize="13sp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="1dp" android:paddingBottom="1dp"
        android:text="•  Pedir turno en la carnicería" android:textColor="@color/widget_texto" android:textSize="13sp" android:maxLines="1" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Widgets con lista (Nota, Lista de BD, Páginas recientes, Calendario pequeño): cabecera,
     línea de estado y la lista. Es un RemoteViews clásico (widgets/Vistas.kt): solo vistas
     que admite RemoteViews y colores de recurso, que el escritorio resuelve en claro u oscuro. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_texto"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_mas"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/widget_nueva"
            android:src="@drawable/widget_boton_mas"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_refrescar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/widget_refrescar"
            android:padding="5dp"
            android:src="@drawable/widget_refrescar" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_aviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:paddingBottom="4dp"
        android:textColor="@color/widget_apagado"
        android:textSize="11sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widget_lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/widget_vacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_apagado"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
